rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Teams: authenticated members can read/update; any authenticated user can create.
    match /teams/{teamId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.memberIds;
      // Teams are soft-deleted via isActive; no hard deletes from the client.
      allow delete: if false;

      // Chat messages: only team members can read or create.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
                       request.auth.uid in
                         get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        // Enforce that senderId matches the authenticated user to prevent spoofing.
        allow create: if request.auth != null &&
                         request.auth.uid in
                           get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds &&
                         request.resource.data.senderId == request.auth.uid;
        // Admins (checked client-side) can delete messages.
        allow delete: if request.auth != null &&
                         request.auth.uid in
                           get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        allow update: if false;
      }
    }

    // Games: public games are readable by anyone authenticated;
    // private games are only readable by team members.
    match /games/{gameId} {
      allow read: if request.auth != null && (
        resource.data.isPublic == true ||
        request.auth.uid in
          get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds
      );
      allow create: if request.auth != null &&
                       request.auth.uid in
                         get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.memberIds;
      allow update: if request.auth != null &&
                       request.auth.uid in
                         get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds;
      allow delete: if false;
    }

    // Reports: any authenticated user can file a report; no client reads.
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
